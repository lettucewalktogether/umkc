# Shared instructor passcode for /umkc/govtacctclass/dashboard.
# Required: without it the dashboard cannot be entered.
INSTRUCTOR_PASSCODE=

# Class identifier stamped onto every exported spreadsheet and its filename.
# Optional: defaults to UMKC-GOVTACCT-HUBER.
NEXT_PUBLIC_CLASS_CODE=UMKC-GOVTACCT-HUBER

# PostHog product analytics. Optional: without a key PostHog never loads.
# Both are public client-side values, not secrets.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Microsoft Clarity project id. Optional override; the app already defaults to
# the class project. Public value, not a secret.
NEXT_PUBLIC_CLARITY_ID=
